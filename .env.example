# Copy this file to `.env` (same folder) and fill in your own values.
# `.env` is gitignored — never commit real credentials.
#
# Lets Lineup Lab send the "verify your email" message on signup, via
# Gmail's SMTP relay. Without this, signup still works fine — accounts
# just stay unverified until this is set up.
#
# How to get an App Password (NOT your normal Gmail password):
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password:      https://myaccount.google.com/apppasswords
#      (name it anything, e.g. "Lineup Lab" — Google shows the 16-character
#      password once, so copy it immediately)
#   3. Paste your Gmail address and that app password below.

GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword

# ------------------------------------------------------------------------
# "Continue with Google" sign-in. Without this, signup/login still work
# fine via username+password — the Google button just doesn't appear.
#
# How to get these:
#   1. https://console.cloud.google.com/apis/credentials
#   2. Create Credentials -> OAuth client ID -> Application type: Web application
#   3. Authorized redirect URI: http://localhost:8420/api/auth/google/callback
#      (add your real domain's equivalent too, if this ever runs somewhere else)
#   4. Copy the Client ID and Client Secret below.

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ------------------------------------------------------------------------
# "Continue with Apple" — not wired into the UI yet (needs a paid Apple
# Developer account, $99/yr). engine/oauth.py is ready for it: set these
# four once you have them and it works the same way Google does.
#
#   APPLE_CLIENT_ID=com.you.lineuplab.web      # your Services ID
#   APPLE_TEAM_ID=...                          # from your Apple Developer account
#   APPLE_KEY_ID=...                           # from the Sign in with Apple key you create
#   APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ------------------------------------------------------------------------
# AI-written player news summary (player detail view). Without this, the
# player modal still shows real matched headlines from ESPN/CBS RSS —
# just without the short written summary on top. The summary is always
# grounded only in those real, already-fetched headlines; nothing is
# invented if a player has no real news.
#
# How to get a key: https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------------------
# Weekly-refresh automation (see engine/refresh_scheduler.py). How often,
# in hours, the server force-refreshes all board data in the background
# — same work POST /api/refresh does on demand, just on a timer, so the
# board is warm before anyone asks and a newly published season gets
# picked up without a restart. Default 24 (daily) matches how often
# nflverse's stats actually change. Set to 0 to disable the background
# task entirely (POST /api/refresh still works either way).

REFRESH_INTERVAL_HOURS=24

# ------------------------------------------------------------------------
# Accounts database (engine/db.py) — real hosted Postgres (Supabase),
# required now. Accounts/sessions/settings/connected-teams all live here;
# nothing else in the app needs this (the board/matchup engine doesn't
# touch a database at all). Without this set, the app still starts and
# every non-account feature still works — signup/login/Settings just
# won't until it's set.
#
# How to get it (Supabase project "LineUp Lab" already exists):
#   1. https://supabase.com/dashboard/project/kxcereopnltktnxhukbc/settings/database
#   2. Under "Connection string", copy the URI (Session pooler recommended
#      for a normal server process — Transaction pooler if you deploy to
#      a serverless/edge platform that opens many short-lived connections).
#   3. Paste it below, with your real database password in place of
#      [YOUR-PASSWORD].

DATABASE_URL=postgresql://postgres.kxcereopnltktnxhukbc:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------
# At-rest encryption key for sensitive settings (currently: ESPN's
# espn_s2/SWID cookies — see engine/crypto.py). Without this set, the app
# auto-generates one on first run and caches it in a local `.app_secret_key`
# file — fine on a machine with a persistent disk, but WRONG for most
# hosting platforms: a container/instance that gets rebuilt on every
# deploy has no persistent disk, so a new key gets generated each time
# and every previously-encrypted ESPN cookie in the database silently
# stops decrypting (the app treats that as "not configured" and asks
# the user to reconnect — not a crash, but a real, avoidable annoyance
# for anyone who'd already connected ESPN before that redeploy).
#
# Before deploying anywhere with an ephemeral filesystem: generate one
# real key ONCE and set it here / in your host's secret store, so it
# survives every future redeploy instead of regenerating.
#
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

APP_SECRET_KEY=
